# =====================================================================
# 🐳  DOCKER SECRETS — `*_FILE` CONVENTION
# =====================================================================
# For every sensitive variable below, you can provide its value via a
# file instead of an inline env var. The loader (src/config/secrets.ts)
# resolves `VAR_FILE` -> reads the file -> assigns the contents to `VAR`.
#
# In Docker Swarm stack templates, this looks like:
#
#   services:
#     api:
#       environment:
#         JWT_ACCESS_SECRET_FILE: /run/secrets/jwt_access_secret
#       secrets:
#         - jwt_access_secret
#
#   secrets:
#     jwt_access_secret:
#       external: true
#
# Precedence (highest wins):
#   1. inline `VAR`            — overrides everything (for local debugging)
#   2. `VAR_FILE`              — Docker / k8s secret file
#   3. `.env` from `dotenv`    — local development
#   4. fallback defaults in code
#
# Variables that SUPPORT the `_FILE` convention are marked with 🔒 below.
# Non-sensitive vars (URLs, flags, sizes, expiry strings) do NOT support
# `_FILE` and should remain as plain env vars.
# =====================================================================

# ==================== SERVER ====================
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:4200

# ==================== DATABASE ====================
# 🔒 MONGODB_URI — supports _FILE
#   Production example:
#     MONGODB_URI_FILE=/run/secrets/mongodb_uri
#     (file contains: mongodb://user:pass@mongo:27017/<db-name>?authSource=admin)
# ⚠️ باید شامل ?replicaSet=rs0 باشد — تراکنش‌های Mongoose (startSession/withTransaction)
#   روی مونگوی standalone شکست می‌خورند. داخل Docker از docker-compose استفاده کنید
#   که mongo را با --replSet rs0 بالا می‌آورد و rs.initiate را در healthcheck انجام می‌دهد.
MONGODB_URI=mongodb://localhost:27017/iranian-udemy?replicaSet=rs0
# 🔒 MONGODB_URI_TEST — supports _FILE
MONGODB_URI_TEST=mongodb://localhost:27017/iranian-udemy-test?replicaSet=rs0

# ==================== JWT ====================
# 🔒 JWT_ACCESS_SECRET — supports _FILE (REQUIRED in production)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
# 🔒 JWT_REFRESH_SECRET — supports _FILE (REQUIRED in production)
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
# 🔒 JWT_EMAIL_VERIFY_SECRET — supports _FILE
JWT_EMAIL_VERIFY_SECRET=your_email_verify_secret
# 🔒 JWT_RESET_PASSWORD_SECRET — supports _FILE
JWT_RESET_PASSWORD_SECRET=your_reset_password_secret

# ==================== REDIS ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 🔒 REDIS_PASSWORD — supports _FILE
REDIS_PASSWORD=

# ==================== CLOUDINARY ====================
CLOUDINARY_CLOUD_NAME=your_cloud_name
# 🔒 CLOUDINARY_API_KEY — supports _FILE
CLOUDINARY_API_KEY=your_api_key
# 🔒 CLOUDINARY_API_SECRET — supports _FILE
CLOUDINARY_API_SECRET=your_api_secret

# ==================== EMAIL (SMTP) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 🔒 SMTP_USER — supports _FILE
SMTP_USER=your_email@gmail.com
# 🔒 SMTP_PASS — supports _FILE (REQUIRED if SMTP is enabled)
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Iranian Udemy
SMTP_FROM_EMAIL=noreply@iranianudemy.com

# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=your_google_client_id
# 🔒 GOOGLE_CLIENT_SECRET — supports _FILE
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ==================== GITHUB OAUTH ====================
GITHUB_CLIENT_ID=your_github_client_id
# 🔒 GITHUB_CLIENT_SECRET — supports _FILE
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost:4200

# ==================== PAYMENT (NikPal) ====================
# ❌ قدیمی (زرین‌پال — دیگر استفاده نمی‌شود):
# ZARINPAL_MERCHANT_ID=your_merchant_id
# ZARINPAL_SANDBOX=true
# ZARINPAL_CALLBACK_URL=http://localhost:5000/api/v1/payments/verify

# ✅ جدید (NikPal):
NIKPAL_API_KEY=
NIKPAL_SANDBOX=false
NIKPAL_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback
FRONTEND_PAYMENT_SUCCESS_URL=http://localhost:4200/payment/success
FRONTEND_PAYMENT_FAILURE_URL=http://localhost:4200/payment/failure
BACKEND_URL=http://localhost:5000

# ==================== RATE LIMIT ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# ==================== FILE & MEDIA UPLOAD ====================
MAX_FILE_SIZE=104857600
MAX_IMAGE_SIZE=2097152
MAX_VIDEO_SIZE=5368709120
UPLOAD_PATH=./uploads

# ==================== S3-Compatible Storage (ویدیوها و فایل‌های بزرگ) ====================
# برای آپلود ویدیو و فایل‌های بزرگ از S3-Compatible Storage استفاده می‌شود.
# تصاویر کوچک (thumbnail, avatar) همچنان از Cloudinary استفاده می‌کنند.
#
# نکته: هر سرویس S3-compatible کار می‌کند:
#   - ArvanCloud: https://s3.{region}.arvanstorage.ir
#   - AWS S3: https://s3.{region}.amazonaws.com
#   - Backblaze B2: https://s3.{region}.backblazeb2.com
#   - MinIO: http://minio-host:9000
#   - DigitalOcean Spaces: https://{region}.digitaloceanspaces.com
#
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=your-bucket-name
S3_FORCE_PATH_STYLE=true
CDN_URL=

# ==================== Video Processing (FFmpeg + BullMQ) ====================
# مسیر باینری FFmpeg در کانتینر
FFMPEG_PATH=/usr/bin/ffmpeg
# مسیر باینری FFprobe در کانتینر (برای استخراج مدت زمان ویدیو روی Alpine - اضافه شد ✅)
FFPROBE_PATH=/usr/bin/ffprobe

# پوشه موقت برای پردازش ویدیوها (باید با Docker volume همخوانی داشته باشد - اضافه شد ✅)
TEMP_DIR=/home/app/scratch

# حداکثر حجم ویدیو مجاز برای آپلود نهایی (5GB)
MAX_VIDEO_SIZE=5368709120
# حداکثر حجم فایل پیوست (100MB)
MAX_RESOURCE_SIZE=104857600

# حداکثر حجم مجاز برای آپلود پروکسی (100MB - جهت جلوگیری از کرش RAM سرور - اضافه شد ✅)
PROXY_UPLOAD_MAX_SIZE=104857600

# اندازه هر بخش Multipart Upload برای فایل‌های بزرگ (10MB)
MULTIPART_PART_SIZE=10485760
# تعداد آپلودهای موازی همزمان در Worker
MULTIPART_CONCURRENT=3

# ==================== Multi-Tenant Config ====================
# فعال/غیرفعال‌سازی سیستم چند‌مستأجری (جلوگیری از باگ فیلد tenant در مدل‌ها - اضافه شد ✅)
MULTI_TENANT_ENABLED=false